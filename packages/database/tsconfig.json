{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "lib": ["ES2022"],
    "types": ["node"],
    // PGlite's extensions ship as ES modules; "nodenext" lets this CommonJS package load them (require(esm)).
    "module": "nodenext",
    "moduleResolution": "nodenext"
  },
  "include": ["src"],
  "references": [{ "path": "../engine" }, { "path": "../netlist" }]
}
