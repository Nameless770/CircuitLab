{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    // The engine must stay portable (Node, browser, worker). Plain ES2022 lib and no ambient
    // @types means `import "fs"`, `process`, `Buffer`, or even `console` fail to compile here.
    "lib": ["ES2022"],
    "types": []
  },
  "include": ["src"]
}
