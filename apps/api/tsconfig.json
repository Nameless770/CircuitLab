{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "lib": ["ES2022"],
    "types": ["node"],
    // NestJS 12 ships as ES modules. This app stays CommonJS like the rest of the repository;
    // "nodenext" lets it load them with Node's require(esm), as Nest's migration guide advises.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    // Nest's dependency injection reads constructor parameter types from decorator metadata.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src"],
  "references": [
    { "path": "../../packages/engine" },
    { "path": "../../packages/netlist" },
    { "path": "../../packages/runner" },
    { "path": "../../packages/api-contract" },
    { "path": "../../packages/database" }
  ]
}
