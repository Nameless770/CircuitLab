{
  // The app window's code runs in Chromium and is bundled by Vite, so it doesn't use the repo's
  // tsconfig.base.json (that one compiles Node packages to CommonJS). tsc only type-checks here;
  // Vite does the actual building.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "noEmit": true,

    // The same strictness as the rest of the repo.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    // We import *types* from the backend packages (@circuitlab/api-contract, @circuitlab/engine).
    // This option makes us write `import type`, which is always removed from the bundle, so Node
    // code from the backend can never end up in the browser by accident.
    "verbatimModuleSyntax": true,
    "isolatedModules": true
  },
  "include": ["src", "test"]
}
