{
  // The Electron main process and preload script (Node code). tsc only type-checks them; Vite
  // builds them into dist/electron/ with the engine and netlist bundled in (vite.main.config.mts),
  // so the installed app needs no node_modules. The window's code has its own tsconfig
  // (../tsconfig.json).
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"]
  },
  "include": ["*.ts"]
}
