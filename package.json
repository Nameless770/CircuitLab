{
  "name": "circuitlab",
  "version": "0.1.0",
  "private": true,
  "description": "Digital logic circuit simulator",
  "scarfSettings": {
    "enabled": false
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples"
  ],
  "scripts": {
    "build": "npm run generate -w @circuitlab/database && tsc -b",
    "test": "npm run build && tsc -p tsconfig.test.json && npm run typecheck -w @circuitlab/desktop && vitest run",
    "test:coverage": "npm run build && vitest run --coverage",
    "test:watch": "vitest",
    "clean": "tsc -b --clean",
    "demo": "npm run build && node examples/dist/demo.js",
    "demo:netlist": "npm run build && node examples/dist/netlist-demo.js",
    "demo:async": "npm run build && node examples/dist/async-demo.js",
    "demo:api": "npm run build && node examples/dist/api-demo.js",
    "lint:api": "npm run lint:spec -w @circuitlab/api-contract",
    "start:api": "npm run build && node --env-file-if-exists=.env apps/api/dist/main.js",
    "start:worker": "npm run build && node --env-file-if-exists=.env apps/api/dist/worker.js",
    "dev:desktop": "npm run build && npm run dev -w @circuitlab/desktop",
    "start:desktop": "npm run build && npm run start -w @circuitlab/desktop",
    "e2e:desktop": "npm run build && npm run e2e -w @circuitlab/desktop",
    "package:desktop": "npm run build && npm run package -w @circuitlab/desktop",
    "demo:http": "npm run build && node examples/dist/http-demo.js",
    "demo:auth": "npm run build && node examples/dist/auth-demo.js",
    "demo:patterns": "npm run build && node examples/dist/patterns-demo.js",
    "eval:assistant": "npm run build && node examples/dist/assistant-eval.js",
    "demo:jobs": "npm run build && node --env-file-if-exists=.env examples/dist/jobs-demo.js",
    "db:check": "npm run build && node packages/database/dist/check-schema.js",
    "db:start": "npm run build && npm run start -w @circuitlab/database",
    "db:migrate": "npm run migrate -w @circuitlab/database",
    "db:status": "npm run migrate:status -w @circuitlab/database",
    "db:studio": "npm run studio -w @circuitlab/database",
    "redis:start": "docker run --rm --name circuitlab-redis -p 6379:6379 redis:8-alpine"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "~5.0.3",
    "typescript": "~6.0.3",
    "vitest": "~5.0.3"
  }
}
