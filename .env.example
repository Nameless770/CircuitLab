# Copy this file to .env (which is not committed) to use the local database:
#   npm run db:start      (leave it running)
#   npm run db:migrate
#   npm run start:api
# Without DATABASE_URL the API keeps circuits in memory and loses them when it stops.
# A variable set in the shell wins over the same one in .env.

# PostgreSQL connection string. Never commit one with a real password.
DATABASE_URL=postgresql://postgres@127.0.0.1:5433/postgres

# Connections in the API's pool (default 10). The local dev database (npm run db:start) needs 1;
# a real PostgreSQL server can take more.
DATABASE_POOL_SIZE=1

# The key that signs access tokens (at least 32 characters). Without it the API makes a random
# one at startup, so everyone is signed out whenever it restarts. Generate your own, and never
# commit it:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# JWT_SECRET=
