# Copy this file to .env (which is not committed) to use the local database and Redis:
#   npm run db:start      (leave it running)
#   npm run redis:start   (leave it running; needs Docker)
#   npm run db:migrate
#   npm run start:api
# Without DATABASE_URL the API keeps circuits in memory and loses them when it stops. Without
# REDIS_URL the cache, the sign-in throttle, and the job queue live in the API's memory, which is
# fine for one process.
# A variable set in the shell wins over the same one in .env.

# PostgreSQL connection string. Never commit one with a real password.
DATABASE_URL=postgresql://postgres@127.0.0.1:5433/postgres

# Connections in the API's pool (default 10). The local dev database (npm run db:start) needs 1;
# a real PostgreSQL server can take more.
DATABASE_POOL_SIZE=1

# How long a request waits for a free connection before the API answers 503 (default 5000 ms; 0
# waits for ever). Without a limit, a busy database makes requests pile up instead.
# DATABASE_POOL_TIMEOUT_MS=5000

# How long finished simulations and truth-table jobs stay in a circuit's history, in days (default
# 30; 0 keeps them for ever). Housekeeping deletes the older ones every 10 minutes, in batches.
# RUN_RETENTION_DAYS=30

# The key that signs access tokens (at least 32 characters). Without it the API makes a random
# one at startup, so everyone is signed out whenever it restarts, and several API copies reject
# each other's tokens (they must share one key). Generate your own, and never commit it:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# JWT_SECRET=

# Redis: the result cache, the sign-in throttle, and background jobs (BullMQ), shared by every API
# instance and worker. The local one: npm run redis:start
REDIS_URL=redis://127.0.0.1:6379

# Optional. A separate Redis for the cache, which may then evict old entries when memory runs out
# (maxmemory-policy allkeys-lru), while the main Redis must never evict (BullMQ needs noeviction).
# REDIS_CACHE_URL=

# Truth-table jobs this process computes at once (default 1). 0 makes an API-only instance; the
# jobs then need a worker: npm run start:worker
# JOB_CONCURRENCY=1

# How long results stay cached, in seconds (default 3600); 0 turns the cache off.
# CACHE_TTL_SECONDS=3600

# How many reverse proxies stand in front of the API (default 0). 1 behind Caddy, nginx or a
# platform's load balancer: the client's address, which the sign-in throttle and the address limit
# below count by, is then read from X-Forwarded-For. Never more than the real number, or clients
# could make up their address. docker-compose.prod.yml sets it to 1.
# TRUST_PROXY=0

# Sign-ins and registrations one address may make in a minute (default 0: no limit). Each costs a
# password hash, so a stream of them can keep the API's CPUs busy (docs/system-design.md measured it).
# Behind a proxy it needs TRUST_PROXY too. docker-compose.prod.yml sets 30; behind an address that
# many people share, such as a school's, raise it (docs/deploy.md).
# AUTH_RATE_LIMIT=0

# --- Docker (docker compose up) -------------------------------------------------------------
# docker-compose.yml reads JWT_SECRET (above) and these two from this file. It ignores
# DATABASE_URL and REDIS_URL here: its containers have their own PostgreSQL and Redis.
#
# The database password inside Docker (default: circuitlab). Nothing outside Docker can reach
# that database, but change it anyway if the computer is shared.
# POSTGRES_PASSWORD=
#
# The API's port on this computer (default 3000), if 3000 is taken.
# API_PORT=3000

# --- Going online (docker-compose.prod.yml, docs/deploy.md) ------------------------------------
# Used with: docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
# These three are REQUIRED there: Compose stops, naming the missing one, without them.
#
# Your domain name, pointing at the server. Caddy gets and renews its HTTPS certificate.
# SITE_ADDRESS=demo.example.com
#
# JWT_SECRET (above) and POSTGRES_PASSWORD (in the Docker section) are required too. The password
# goes into a connection URL, so use letters and digits only:
#   openssl rand -hex 24
#
# Optional: sign-ins and registrations per address per minute (default 30).
# AUTH_RATE_LIMIT=30
#
# Optional, for trying the production file on a computer where ports 80 and 443 are taken.
# HTTP_PORT=80
# HTTPS_PORT=443
